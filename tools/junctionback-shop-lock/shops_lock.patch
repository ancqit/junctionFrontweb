+@router.put("/lock-status", response_model=Shop)
+def update_lock_status(
+    payload: ShopLockStatusUpdate,
+    current_user: Annotated[dict, Depends(get_current_user)],
+):
+    """Owner toggles shop between owner and viewer (partial lock)."""
+    shop = find_shop_by_name_for_user(payload.name.strip(), current_user)
+    if shop is None:
+        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="Shop not found")
+    ensure_shop_access(current_user, shop)
+    lock_reason = payload.lock_reason if payload.is_locked else None
+    shops.update_one(
+        {"_id": shop["_id"]},
+        {
+            "$set": {
+                "is_locked": payload.is_locked,
+                "lock_reason": lock_reason,
+                "updated_at": datetime.now(timezone.utc),
+            }
+        },
+    )
+    updated = shops.find_one({"_id": shop["_id"]})
+    return shop_from_doc(updated)
+
