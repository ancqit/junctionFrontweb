{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:back-office",
  "outputDirectory": "dist/apps/back-office/browser",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
