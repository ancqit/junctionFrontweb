{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/vercel",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!remotes/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/remotes/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
